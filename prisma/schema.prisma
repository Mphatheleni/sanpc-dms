generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                    @id @default(cuid())
  name                     String
  email                    String                    @unique
  password                 String
  role                     Role
  departmentRole           String?
  createdAt                DateTime                  @default(now())
  authorizedDocuments      Document[]                @relation("AuthorizerOf")
  originatedDocuments      Document[]                @relation("OriginatorOf")
  uploadedDocuments        Document[]                @relation("UploadedBy")
  activities               DocumentActivity[]        @relation("ActivityUser")
  comments                 DocumentComment[]
  reviews                  DocumentReview[]
  versionUploads           DocumentVersion[]         @relation("VersionUploadedBy")
  attachmentUploads        DocumentAttachment[]      @relation("AttachmentUploadedBy")
  mandatoryReviewerConfigs MandatoryReviewerConfig[]
  notifications            Notification[]
}

/// Maps a document type to specific mandatory reviewers (person-based).
/// When uploading a document of this type, these people are pre-selected as reviewers.
model MandatoryReviewerConfig {
  id           String   @id @default(cuid())
  documentType String
  userId       String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentType, userId])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String
  title      String
  message    String
  documentId String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id                 String             @id @default(cuid())
  title              String
  description        String?
  category           String?
  tags               String?
  fileUrl            String
  fileName           String
  fileType           String
  fileSize           Int
  status             DocumentStatus     @default(DRAFT)
  version            Int                @default(1)
  sharePointUrl      String?
  sharePointItemId   String?
  reviewDeadlineDays Int?
  documentNumber     String?
  revision           String?            @default("00")
  originalDate       String?
  authorisedBy       String?
  originator         String?
  purpose            String?
  documentTypeCode   String?
  nextReviewDate     String?
  retentionDate      String?
  signedPageUrl      String?
  signedPageName     String?
  excoResolutionUrl  String?
  excoResolutionName String?
  isExcoRequired     Boolean            @default(false)
  controlledAt       String?
  amendmentCount     Int                @default(0)
  originatorId       String?
  authorizerId       String?
  uploadedById       String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  authorizerUser     User?              @relation("AuthorizerOf", fields: [authorizerId], references: [id])
  originatorUser     User?              @relation("OriginatorOf", fields: [originatorId], references: [id])
  uploadedBy         User               @relation("UploadedBy", fields: [uploadedById], references: [id])
  activities         DocumentActivity[]
  attachments        DocumentAttachment[]
  comments           DocumentComment[]
  metadata           DocumentMetadata[]
  reviews            DocumentReview[]
  versions           DocumentVersion[]
}

model DocumentMetadata {
  id         String   @id @default(cuid())
  documentId String
  key        String
  value      String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DocumentReview {
  id             String       @id @default(cuid())
  documentId     String
  reviewerId     String
  order          Int
  isApprover     Boolean      @default(false)
  isMandatory    Boolean      @default(false)
  mandatoryRole  String?
  status         ReviewStatus @default(PENDING)
  comments       String?
  reviewedAt     DateTime?
  startedAt      DateTime?
  deadline       DateTime?
  reminderSentAt DateTime?
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewer       User         @relation(fields: [reviewerId], references: [id])
}

model DocumentComment {
  id         String   @id @default(cuid())
  documentId String
  authorId   String
  content    String
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id])
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  versionNumber Int
  fileUrl       String
  fileName      String
  fileType      String
  fileSize      Int
  uploadedById  String
  createdAt     DateTime @default(now())
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy    User     @relation("VersionUploadedBy", fields: [uploadedById], references: [id])
}

/// DLT-09: Attachments unlocked after Approved status (signed PDF, board resolution, Word master, etc.)
model DocumentAttachment {
  id           String   @id @default(cuid())
  documentId   String
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  label        String?
  uploadedById String
  createdAt    DateTime @default(now())
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])
}

model DocumentActivity {
  id         String         @id @default(cuid())
  documentId String
  userId     String
  action     ActivityAction
  details    String?
  createdAt  DateTime       @default(now())
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User           @relation("ActivityUser", fields: [userId], references: [id])
}

enum Role {
  ADMIN
  DOCUMENT_MANAGER
  REVIEWER
  APPROVER
  ORIGINATOR
}

enum DocumentStatus {
  REGISTERED
  DRAFT
  PENDING_REVIEW
  IN_REVIEW
  UPDATING
  REVIEW_COMPLETE
  FINAL_DRAFT
  PENDING_APPROVAL
  APPROVED
  EXCO_PENDING
  CONTROLLED
  SUPERSEDED
  CANCELLED
  REJECTED
  CHANGES_REQUESTED
}

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  REMOVED
}

enum ActivityAction {
  CREATED
  VIEWED
  DOWNLOADED
  SUBMITTED
  REVIEW_APPROVED
  REVIEW_REJECTED
  REVIEW_CHANGES_REQUESTED
  APPROVED
  REJECTED
  COMMENT_ADDED
  CONTROLLED
  SUPERSEDED
  CANCELLED
  EXCO_SUBMITTED
  SIGNED_PAGE_UPLOADED
  AMENDED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  STATUS_CHANGED
}
